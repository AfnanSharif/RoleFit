# Text/PDF/image extraction and offline analysis need no cloud key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Azure deployment helper (use a globally unique lowercase ACR name).
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rolefit-prod-rg
AZURE_LOCATION=eastus
AZURE_ACR_NAME=
AZURE_APP_NAME=rolefit-studio
IMAGE_TAG=latest
